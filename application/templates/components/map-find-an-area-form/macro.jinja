{% macro dlFindAnAreaForm(params) %}
{% from "govuk_frontend_jinja/components/radios/macro.html" import govukRadios %}

{% set search_query = params.get("search_query", "") %}
{% set search_result = params.get("search_result", {}) %}
{% set error = params.get("error", []) %}

{# No radio is selected by default - the user picks a method before its
   input/button appear. If there's an existing search result, pre-select
   whichever method it's for - unless that search actually succeeded
   (search_result.result is populated), in which case the method's own
   job is done ("Showing results for..." below already shows what was
   found) and the radio is left deselected, collapsing its input/button
   away. On a failed/no-match search there's nothing to show instead, so
   the method stays selected with its input visible for the user to
   correct. FindAnAreaForm.js separately corrects the selection from the
   URL's `type` param on load (covering the validation error case, where
   there's a submitted type but no search_result yet), and applies this
   same successful-result exception. #}
{% set selected_method = search_result.type if search_result and search_result.get("type") and not search_result.get("result") else "" %}

{% set postcodeConditional %}
  <div class="govuk-form-group">
    <label class="govuk-label govuk-visually-hidden" for="postcode-input">Postcode</label>
    <input id="postcode-input" class="govuk-input govuk-input--width-20{% if error %} govuk-input--error{% endif %}" name="q" type="text" spellcheck="false" value="{{ search_query or '' }}">
  </div>
  <button type="submit" id="find-an-area-submit-postcode" class="govuk-button" data-module="govuk-button">
    Find postcode
  </button>
{% endset %}

{% set uprnConditional %}
  <div class="govuk-form-group">
    <label class="govuk-label govuk-visually-hidden" for="uprn-search-input">UPRN</label>
    <input id="uprn-search-input" class="govuk-input govuk-input--width-20{% if error %} govuk-input--error{% endif %}" name="q" type="text" spellcheck="false" value="{{ search_query or '' }}">
  </div>
  <button type="submit" id="find-an-area-submit-uprn" class="govuk-button" data-module="govuk-button">
    Find UPRN
  </button>
{% endset %}

{% set lpaConditional %}
  <div class="govuk-form-group">
    <label class="govuk-label govuk-visually-hidden" for="lpa-autocomplete-input">Local planning authority</label>
    <input id="lpa-autocomplete-input" class="govuk-input govuk-input--width-20{% if error %} govuk-input--error{% endif %}" type="text" name="q" autocomplete="off" value="{{ search_query or '' }}">
    <div id="lpa-suggestions" class="js-hidden">
      <ul id="lpa-autocomplete-suggestions" role="listbox" aria-label="Local planning authority suggestions"></ul>
    </div>
  </div>
  <button type="submit" id="find-an-area-submit-lpa" class="govuk-button" data-module="govuk-button">
    Find local planning authority
  </button>
{% endset %}

<form class="dl-find-an-area-form" method="get" id="dl-find-an-area-form">
  {{ govukRadios({
    "idPrefix": "search-method",
    "name": "type",
    "classes": "govuk-radios--small",
    "fieldset": {
      "legend": {
        "text": "Find an area",
        "classes": "govuk-visually-hidden"
      }
    },
    "errorMessage": {"text": error} if error else None,
    "items": [
      {
        "value": "postcode",
        "text": "Postcode",
        "id": "search-method-postcode",
        "checked": selected_method == "postcode",
        "conditional": {"html": postcodeConditional}
      },
      {
        "value": "uprn",
        "text": "UPRN",
        "id": "search-method-uprn",
        "checked": selected_method == "uprn",
        "conditional": {"html": uprnConditional}
      },
      {
        "value": "lpa",
        "text": "Local Planning Authority",
        "id": "search-method-lpa",
        "checked": selected_method == "lpa",
        "conditional": {"html": lpaConditional}
      }
    ]
  }) }}
</form>

{# Search results #}
{% if search_result %}
  <div class="govuk-!-margin-top-3 govuk-!-margin-bottom-3">
    {% if search_result.get("type") == "postcode" and search_result.get("result") %}
      <p class="govuk-body govuk-!-font-weight-bold">
        Showing results for postcode: {{ search_result.get("result", {}).get("POSTCODE", "") }}
      </p>
    {% elif search_result.get("type") == "uprn" and search_result.get("result") %}
      <p class="govuk-body govuk-!-font-weight-bold">
        Showing results for UPRN: {{ search_result.get("result", {}).get("UPRN", "") }}
      </p>
    {% elif search_result.get("type") == "lpa" and search_result.get("result") %}
      <p class="govuk-body govuk-!-font-weight-bold">
        Showing results for local planning authority: {{ search_result.get("result", {}).get("name", "") }}
      </p>
    {% else %}
      <p class="govuk-body">
        No results found for '{{ search_query }}'.
      </p>
      <p class="govuk-body">
        Check <a href="https://design.planning.data.gov.uk/what-we-are-working-on">our current priorities</a> to see if this data is being prepared for the platform.
      </p>
      <p class="govuk-body">
        If it's not there, you can <a href="https://design.planning.data.gov.uk/get-involved-in-designing-data">contribute to our data design process</a> to help prioritise it.
      </p>
    {% endif %}
  </div>
{% endif %}
{% endmacro %}
